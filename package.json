{
  "name": "security-inspector",
  "private": true,
  "version": "0.2.0",
  "description": "Browser-based security testing tool that observes authentication, manifest delivery, and segment access control on a real, already-deployed target application.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:inspector": "npm run dev -w apps/inspector",
    "dev:web": "npm run dev -w apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
