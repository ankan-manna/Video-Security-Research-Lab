# Copy this file to .env and adjust values. Never commit a real .env file.
# All values below are safe defaults for local development.

# ---- apps/api (Research backend: URL analysis, HAR inspection, findings) ----
API_PORT=4001
NODE_ENV=development

# Comma-separated allowlist of hostnames the URL Analysis Engine is permitted
# to reach. SSRF protections (see docs/SECURITY_MODEL.md) apply in addition
# to this allowlist, not instead of it.
ANALYSIS_ALLOWED_HOSTS=www.youtube.com,youtube.com,m.youtube.com

# Outbound request safety limits enforced by the SSRF guard.
ANALYSIS_REQUEST_TIMEOUT_MS=5000
ANALYSIS_MAX_RESPONSE_BYTES=2097152
ANALYSIS_MAX_REDIRECTS=3

# Simple in-memory rate limiting for the API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Where findings/reports are persisted (JSON file store for the skeleton).
FINDINGS_STORE_PATH=./apps/api/data/findings.json

# Browser origin allowed to call this API via CORS (the Next.js dashboard).
DASHBOARD_ORIGIN=http://localhost:3000

# ---- apps/mock-lab (local mock streaming + auth lab, synthetic data only) ----
MOCK_LAB_PORT=4002
# Synthetic signing secret for demo session tokens issued by the mock lab.
# This is NOT a real credential and must never be reused outside this lab.
MOCK_LAB_SESSION_SECRET=change-me-dev-only-synthetic-secret

# ---- apps/web (Next.js dashboard) ----
# Port used by `npm run dev -w apps/web` (via next dev -p).
WEB_PORT=3000
# NEXT_PUBLIC_* vars are exposed to the browser bundle — keep them limited to
# non-secret base URLs the dashboard needs to reach the other local services.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_MOCK_LAB_BASE_URL=http://localhost:4002
