# Copy this file to .env and adjust values. Never commit a real .env file.
# All values below are safe defaults for local development.

# ---- apps/api (Research backend: URL analysis, HAR inspection, findings) ----
API_PORT=4001
NODE_ENV=development

# Comma-separated allowlist of hostnames the URL Analysis Engine is permitted
# to reach. SSRF protections (see docs/SECURITY_MODEL.md) apply in addition
# to this allowlist, not instead of it.
ANALYSIS_ALLOWED_HOSTS=www.youtube.com,youtube.com,m.youtube.com

# Outbound request safety limits enforced by the SSRF guard.
ANALYSIS_REQUEST_TIMEOUT_MS=5000
ANALYSIS_MAX_RESPONSE_BYTES=2097152
ANALYSIS_MAX_REDIRECTS=3

# Simple in-memory rate limiting for the API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Where findings/reports are persisted (JSON file store for the skeleton).
FINDINGS_STORE_PATH=./apps/api/data/findings.json

# Where URL Analysis Engine results are persisted (capped history, newest first).
ANALYSIS_HISTORY_STORE_PATH=./apps/api/data/analysis-history.json
ANALYSIS_HISTORY_MAX_ENTRIES=50

# HAR (HTTP Archive) import limits. HAR_MAX_UPLOAD_BYTES rejects oversized
# payloads before they're fully buffered (413); HAR_MAX_ENTRIES caps how many
# entries get processed for a HAR that's within the byte limit but has a
# pathological entry count (the response reports `truncated: true`).
HAR_MAX_UPLOAD_BYTES=5000000
HAR_MAX_ENTRIES=1000

# Where HAR import results are persisted (capped history, newest first) —
# same pattern as ANALYSIS_HISTORY_STORE_PATH above.
HAR_HISTORY_STORE_PATH=./apps/api/data/har-history.json
HAR_HISTORY_MAX_ENTRIES=50

# Max size of pasted manifest text accepted by the Streaming Manifest
# Analyzer's `content` mode (its `url` mode instead goes through the
# ANALYSIS_* limits above via the same safeFetch guard).
MANIFEST_MAX_CONTENT_BYTES=1000000

# Where manifest parse results are persisted (capped history, newest first).
MANIFEST_HISTORY_STORE_PATH=./apps/api/data/manifest-history.json
MANIFEST_HISTORY_MAX_ENTRIES=50

# Browser origin allowed to call this API via CORS (the Next.js dashboard).
DASHBOARD_ORIGIN=http://localhost:3000

# ---- apps/inspector (browser-based security testing tool) ----
# See docs/REFACTOR_PLAN.md, docs/ARCHITECTURE.md, and docs/SECURITY_MODEL.md.
INSPECTOR_PORT=4002

# Where target config, captured evidence (events/manifests), and session-state history are
# persisted. Never the same directory as the browser profile below — see
# docs/SECURITY_MODEL.md's "Browser profile isolation."
INSPECTOR_DATA_DIR=./apps/inspector/data

# A dedicated Playwright user-data-dir holding real cookies/local-storage for whatever account
# the operator manually signs in as. Must never be committed, logged, or exported — already
# .gitignore'd.
INSPECTOR_BROWSER_PROFILE_DIR=./apps/inspector/browser-profile

BROWSER_LAUNCH_TIMEOUT_MS=30000

# Visible by default (false) — the entire point is a human signs in and plays video manually.
# Set true only for automated tests or a genuinely headless host; never set true to "automate"
# what should be a manual login.
INSPECTOR_HEADLESS=false

# Session-state polling fallback — used only for cookie-name changes, which have no native
# Playwright "changed" event. Navigation/response signals come from real browser events, no
# polling needed for those. See docs/SESSION_MONITORING.md.
SESSION_MONITOR_POLL_INTERVAL_MS=5000

# Local evidence retention (network events, manifest records). Oldest entries are dropped once
# either limit is exceeded.
EVIDENCE_RETENTION_MAX_EVENTS=5000
EVIDENCE_RETENTION_MAX_AGE_HOURS=72

# ---- apps/web (Next.js dashboard) ----
# Port used by `npm run dev -w apps/web` (via next dev -p).
WEB_PORT=3000
# NEXT_PUBLIC_* vars are exposed to the browser bundle — keep them limited to
# non-secret base URLs the dashboard needs to reach the other local services.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_INSPECTOR_BASE_URL=http://localhost:4002
